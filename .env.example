# Copy to .env (root) or apps/server/.env for local dev. Never commit real secrets.
# See plan.md §24 + docs/runbook.md — secrets live in host secret manager in prod.

# Server
PORT=3000
LOG_LEVEL=info
# Comma-separated allowed origins for strict CORS (mobile uses token auth; no wildcard in prod)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Postgres (matches infra/docker/compose.yml dev defaults)
# 127.0.0.1 (not localhost): Docker Desktop on Windows doesn't reliably forward IPv6 ::1.
DATABASE_URL=postgresql://orbit:orbit_dev_pw@127.0.0.1:5432/orbit?schema=public
# Optional Redis (only needed when scaling sockets / rate limits)
REDIS_URL=redis://127.0.0.1:6379

# Auth (M1+) — required in prod, dev placeholders only. Generate with e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=dev-only-change-me-min-32-chars-000000000000
JWT_REFRESH_SECRET=dev-only-change-me-min-32-chars-111111111111
# Access token TTL minutes (10–15 per plan.md §5)
JWT_ACCESS_TTL_MIN=15
