{
  "name": "@orbit/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:mock": "tsx src/index.ts --mock-server",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --import tsx ./test/*.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "@orbit/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/ws": "^8.5.13",
    "tsx": "^4.16.2",
    "typescript": "^5.6.3"
  }
}
