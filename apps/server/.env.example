# M0 — copied to apps/server/.env for local dev. Never commit real secrets.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# 127.0.0.1 (not localhost): Docker Desktop on Windows doesn't reliably forward IPv6 ::1.
DATABASE_URL=postgresql://orbit:orbit_dev_pw@127.0.0.1:5432/orbit?schema=public
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=dev-only-change-me-min-32-chars-000000000000
JWT_REFRESH_SECRET=dev-only-change-me-min-32-chars-111111111111
JWT_ACCESS_TTL_MIN=15
